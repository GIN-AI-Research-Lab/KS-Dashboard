generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DEPARTMENT_HEAD
  MEMBER
}

enum SessionStatus {
  ACTIVE
  IDLE
  ENDED
}

enum ToolCallStatus {
  STARTED
  SUCCESS
  ERROR
}

enum SessionOutcome {
  SOLVED
  IN_PROGRESS
  ABANDONED
}

enum LibraryItemKind {
  PROMPT
  SKILL
}

enum Visibility {
  PUBLIC
  PRIVATE
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  users User[]
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique // canonical email, typically the one synced from AMIS
  emailLocalPart String    @unique // lowercased part before "@" -- lets SSO logins and the
                                    // Claude Code plugin match this user from *any* allowed
                                    // company domain (e.g. tuent@sint.co.jp and
                                    // tuent@kstns.biz both resolve to the same account)
  passwordHash String?     // null for accounts that only ever sign in via SSO
  name         String
  role         Role        @default(MEMBER)
  apiKey       String      @unique
  image        String?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())

  amisEmployeeCode String?   @unique // upsert key for AMIS sync, when available
  lastAmisSyncAt   DateTime?

  note String? // free-text admin note about this employee (on leave, new hire, ...)

  locale String? // UI language preference: "vi" | "en" | "ja". null = app default (vi)

  sessions         ClaudeSession[]
  turns            Turn[]
  toolCalls        ToolCall[]
  sessionComments  SessionComment[]
  sessionFeedback  SessionFeedback[]
  libraryItems     LibraryItem[]
  libraryComments  LibraryComment[]
  libraryReactions LibraryReaction[]
  libraryBookmarks LibraryBookmark[]
}

model ClaudeSession {
  id           String        @id @default(cuid())
  externalId   String        @unique // Claude Code session_id
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Only the project label (last folder name) is stored -- never the full cwd
  // path. See PRIVACY.md.
  projectLabel String?
  source       String? // startup | resume | clear | compact
  model        String?
  status       SessionStatus @default(ACTIVE)
  startedAt    DateTime      @default(now())
  endedAt      DateTime?
  lastEventAt  DateTime      @default(now())

  inputTokens        Int @default(0)
  outputTokens       Int @default(0)
  cacheCreationTokens Int @default(0)
  cacheReadTokens    Int @default(0)
  costUsd            Float @default(0)
  turnCount          Int @default(0)
  toolCallCount      Int @default(0)
  promptCount        Int @default(0)

  // Group A telemetry: edit accept/reject, API errors (from OTel logs), and
  // lines of code changed (from OTel metrics). See /api/otel/logs & /api/otel/metrics.
  editsAccepted Int @default(0)
  editsRejected Int @default(0)
  apiErrorCount Int @default(0)
  linesAdded    Int @default(0)
  linesRemoved  Int @default(0)

  // Human annotation: mark whether a session solved its problem, add a note and
  // tags, and feature notable sessions in the knowledge library.
  outcome     SessionOutcome?
  note        String?
  tags        String? // comma-separated
  featured    Boolean         @default(false)
  annotatedAt DateTime?

  transcriptOffset Int @default(0) // bytes already parsed from transcript, used by plugin

  turns     Turn[]
  toolCalls ToolCall[]
  comments  SessionComment[]
  feedback  SessionFeedback[]

  @@index([userId])
  @@index([status])
  @@index([startedAt])
}

model Turn {
  id         String        @id @default(cuid())
  externalId String?       @unique // OTel api_request.request_id -- idempotency key so
                                    // retried/duplicate OTel batches don't double-count a turn
  sessionId  String
  session    ClaudeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  model      String
  inputTokens         Int @default(0)
  outputTokens        Int @default(0)
  cacheCreationTokens Int @default(0)
  cacheReadTokens     Int @default(0)
  costUsd             Float @default(0)
  durationMs Int? // total api_request duration (OTel)
  ttftMs     Int? // time-to-first-token (OTel)
  stopReason String?
  createdAt  DateTime      @default(now())

  @@index([sessionId])
  @@index([userId])
  @@index([createdAt])
  @@index([model])
  @@index([userId, createdAt])
}

model ToolCall {
  id         String         @id @default(cuid())
  sessionId  String
  session    ClaudeSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolName   String
  // NOTE: we deliberately store NO tool input/output content (no command text,
  // file paths, diffs, prompts) -- only the tool name + status + timing. See PRIVACY.md.
  status     ToolCallStatus @default(STARTED)
  startedAt  DateTime       @default(now())
  endedAt    DateTime?
  durationMs Int?

  @@index([sessionId])
  @@index([userId])
  @@index([toolName])
  @@index([startedAt])
  @@index([sessionId, startedAt])
}

// Populated by the OTel receiver (/api/otel/logs) from Claude Code's own
// telemetry export, keyed by Claude Code's session id (same value the plugin
// sends as ClaudeSession.externalId). Lets /api/ingest's resolveUser() prefer
// the real logged-in account email over the Windows-username guess, without
// changing the plugin or the hooks pipeline itself -- see HANDOFF.md.
model SessionIdentity {
  sessionId String   @id
  email     String
  updatedAt DateTime @updatedAt
}

// Team discussion on a session. @mentions are parsed from `body` at render time.
model SessionComment {
  id        String        @id @default(cuid())
  sessionId String
  session   ClaudeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime      @default(now())

  @@index([sessionId])
}

// 👍 / 👎 on a session, one vote per user (value = 1 or -1).
model SessionFeedback {
  id        String        @id @default(cuid())
  sessionId String
  session   ClaudeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  value     Int // 1 = up, -1 = down
  createdAt DateTime      @default(now())

  @@unique([sessionId, userId])
  @@index([sessionId])
}

// Shared knowledge library: prompts and skills people post for others. Content
// is added on purpose by users -- the app never auto-captures anything (privacy).
// Each item is PUBLIC (shown in the shared feed) or PRIVATE (only the author).
model LibraryItem {
  id         String          @id @default(cuid())
  kind       LibraryItemKind
  title      String
  body       String
  tags       String? // comma-separated
  // For kind=SKILL only: maps 1-1 onto a Claude Code skill folder.
  // `skillName` is the kebab-case folder name + `/name` invocation and must be
  // globally unique so starred skills never collide on disk. PROMPT items leave
  // it null (Postgres allows many NULLs under a unique index). `skillDescription`
  // becomes the SKILL.md frontmatter `description`.
  skillName        String? @unique
  skillDescription String?
  visibility Visibility      @default(PUBLIC)
  authorId   String
  author     User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  comments  LibraryComment[]
  reactions LibraryReaction[]
  bookmarks LibraryBookmark[]

  @@index([authorId])
  @@index([visibility])
  @@index([kind])
}

model LibraryComment {
  id        String      @id @default(cuid())
  itemId    String
  item      LibraryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  authorId  String
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime    @default(now())

  @@index([itemId])
}

// Emoji reaction; a user may add several distinct emojis but not the same twice.
model LibraryReaction {
  id        String      @id @default(cuid())
  itemId    String
  item      LibraryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime    @default(now())

  @@unique([itemId, userId, emoji])
  @@index([itemId])
}

// Star / bookmark: save an item to your account, one per user per item.
model LibraryBookmark {
  id        String      @id @default(cuid())
  itemId    String
  item      LibraryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([itemId, userId])
  @@index([itemId])
}

// Admin-controlled, global sidebar navigation config. One row per menu `key`
// (see src/lib/menu.ts MENU_ITEMS). Only rows that override a code default need
// to exist; missing keys fall back to the registry defaults. Role gating and
// "always accessible" flags live in code, not here.
model MenuSetting {
  key       String   @id // MenuKey from src/lib/menu.ts
  visible   Boolean
  sortOrder Int
  updatedAt DateTime @updatedAt
}
