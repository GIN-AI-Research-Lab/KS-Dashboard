# ============================================================================
# KS Dashboard — environment variables
# Copy to `.env` and fill in. Everything here is read at server startup.
# For GCP production (Compute Engine VM + Cloud SQL for PostgreSQL) see the
# notes under each section.
# ============================================================================

# ---------------------------------------------------------------------------
# 1) PUBLIC URL & DOMAIN
# ---------------------------------------------------------------------------
# The canonical public address employees use. Set ALL of these to the SAME
# https domain in production. Used for: auth callbacks, OpenGraph/metadata, and
# the telemetry endpoint baked into the downloaded setup file (Integrate page).
#
# GCP: reserve a STATIC external IP for the VM (VPC network > IP addresses >
# Reserve), point your domain's A record at it, and terminate TLS with Caddy or
# nginx (Let's Encrypt) in front of the app on :4000. Then:
DASHBOARD_PUBLIC_URL="https://dashboard.your-company.com"
NEXTAUTH_URL="https://dashboard.your-company.com"
AUTH_URL="https://dashboard.your-company.com"
# App is reached over one hostname behind a proxy -> trust the forwarded host.
AUTH_TRUST_HOST="true"

# ---------------------------------------------------------------------------
# 2) AUTH SECRET (required)
# ---------------------------------------------------------------------------
# Signs the session JWT. Generate once, keep stable:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# 3) DATABASE — Cloud SQL for PostgreSQL
# ---------------------------------------------------------------------------
# RECOMMENDED (VM + Cloud SQL Auth Proxy): run the proxy on the VM, which
# exposes the instance on a local TCP port; Prisma connects to it via localhost.
#   ./cloud-sql-proxy PROJECT:REGION:INSTANCE --port 5432 &
DATABASE_URL="postgresql://ksdash:DB_PASSWORD@127.0.0.1:5432/ksdash?schema=public"
#
# ALTERNATIVE A — Cloud SQL public IP + SSL (no proxy; authorize the VM IP and
# require SSL on the instance):
#   DATABASE_URL="postgresql://ksdash:DB_PASSWORD@CLOUD_SQL_PUBLIC_IP:5432/ksdash?schema=public&sslmode=require"
# ALTERNATIVE B — Unix socket (Cloud Run / App Engine):
#   DATABASE_URL="postgresql://ksdash:DB_PASSWORD@localhost/ksdash?host=/cloudsql/PROJECT:REGION:INSTANCE&schema=public"
# ALTERNATIVE C — self-hosted Postgres on the same VM (cheapest):
#   DATABASE_URL="postgresql://ksdash@127.0.0.1:5433/ksdash?schema=public"
#
# After setting this, apply the schema:  npx prisma db push
# Cloud SQL sizing for ~200 employees: a small instance (1 vCPU / 3.75 GB) is
# plenty; the app is write-light (telemetry inserts) + cached reads.

# ---------------------------------------------------------------------------
# 4) MICROSOFT ENTRA ID — SSO (optional; leave blank for email/password only)
# ---------------------------------------------------------------------------
# Azure Portal > App registrations. Add this Redirect URI (type: Web):
#   https://dashboard.your-company.com/api/auth/callback/microsoft-entra-id
# ISSUER: leave blank for multi-tenant (any Microsoft 365 tenant), or set
#   https://login.microsoftonline.com/<TENANT_ID>/v2.0  to lock to one tenant.
# On SSO login the dashboard adopts the user's Microsoft display name + photo.
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# Company email domains allowed to sign in. SSO/plugin match users by the part
# BEFORE "@", so the same person is recognized across these domains.
ALLOWED_EMAIL_DOMAINS="sint.co.jp,kstns.biz"

# ---------------------------------------------------------------------------
# 5) CLAUDE CODE INGEST (plugin hooks pipeline)
# ---------------------------------------------------------------------------
# Shared company-wide token for the Claude Code plugin's /api/ingest calls
# (identity resolved by username/email, not a per-person key). Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# NOTE: OpenTelemetry telemetry (the Integrate-page setup file) does NOT use
# this token — it authenticates by the user's Claude account email attribute.
KS_DASHBOARD_INGEST_TOKEN=""

# ---------------------------------------------------------------------------
# 6) AMIS HR sync (optional) — Thông tin nhân sự Open API
# ---------------------------------------------------------------------------
# AMIS > Thiết lập > Quản trị dữ liệu > Kết nối ứng dụng
#   ("Mã kết nối" = Client ID, "Khóa bảo mật" = Secret key).
AMIS_CLIENT_ID=""
AMIS_SECRET_KEY=""

# ---------------------------------------------------------------------------
# 7) RUNTIME
# ---------------------------------------------------------------------------
NODE_ENV="production"
