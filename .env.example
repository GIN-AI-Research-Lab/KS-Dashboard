DATABASE_URL="file:./dev.db"
AUTH_SECRET=""

# Multi-domain SSO: local-part-only match across these company domains.
ALLOWED_EMAIL_DOMAINS="sint.co.jp,kstns.biz"

# Microsoft Entra ID SSO -- leave blank to keep credentials-only login active.
# Get these from Azure Portal > App registrations. Redirect URI:
# <your-domain>/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# Shared company-wide token for the Claude Code plugin (identity resolved by
# Windows username instead of a per-person API key). Generate with:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
KS_DASHBOARD_INGEST_TOKEN=""

# AMIS Thông tin nhân sự Open API -- from AMIS > Thiết lập > Quản trị dữ liệu
# > Kết nối ứng dụng ("Mã kết nối" = Client ID, "Khóa bảo mật" = Secret key).
AMIS_CLIENT_ID=""
AMIS_SECRET_KEY=""
